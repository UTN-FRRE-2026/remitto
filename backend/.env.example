# =============================================================
#  Backend Remitto – variables de entorno
#  Copiar a .env:  cp .env.example .env
# =============================================================

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://remitto:remitto@localhost:5433/remitto?schema=public"

# Servidor
PORT=4000
NODE_ENV=development

# Autenticación (RNF1). Cambiar en producción por un secreto largo y aleatorio.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# CORS: origen del frontend
CORS_ORIGIN="http://localhost:5173"

# Comprobantes subidos (HU8). Ruta relativa a backend/ o absoluta.
# Formatos admitidos: JPG, PNG, WEBP, HEIC/HEIF y PDF.
UPLOADS_DIR="uploads"
ARCHIVO_MAX_MB=10

# Lectura de comprobantes con IA (HU9). La clave reside SOLO en el servidor
# (RNF1): no se envía al frontend ni se registra en logs. Sin clave, la
# lectura queda deshabilitada (POST /procesar responde 503).
# Capa gratuita de Gemini: Google puede usar el contenido enviado para
# mejorar sus productos. No se usa service_tier ni otro modelo automáticamente.
IA_API_KEY=""
IA_MODELO="gemini-3.8-flash"
# Opcionales (valores por defecto):
# IA_NIVEL_RAZONAMIENTO="low"   # low | medium | high
# IA_PRESUPUESTO_MS=30000       # tope por ejecución (llamadas + esperas), RNF2
# IA_MAX_INTENTOS=3             # llamadas reales por comprobante (automáticas + manuales)
# IA_VIGENCIA_MS=45000          # vigencia del trabajo; el latido la renueva
# Solo para pruebas sin red, nunca en producción (ok, parcial, ilegible, ...):
# IA_SIMULACION="ok"
