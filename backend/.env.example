# =============================================================
#  Backend Remitto – variables de entorno
#  Copiar a .env:  cp .env.example .env
# =============================================================

# Conexión a PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL="postgresql://remitto:remitto@localhost:5433/remitto?schema=public"

# Servidor
PORT=4000
NODE_ENV=development

# Autenticación (RNF1). Cambiar en producción por un secreto largo y aleatorio.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# CORS: origen del frontend
CORS_ORIGIN="http://localhost:5173"

# Credencial del servicio de IA (reside SOLO en el servidor, RNF1).
# Se usa en el Sprint 1/2 para la ingesta de comprobantes y el agente.
# IA_API_KEY=""
