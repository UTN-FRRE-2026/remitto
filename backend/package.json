{
  "name": "remitto-backend",
  "version": "0.1.0",
  "description": "API REST de Remitto – gestión de stock para comercios de cercanía",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "reset-intentos": "node scripts/reset-intentos.js",
    "conciliar-stock": "node scripts/conciliar-stock.js",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@prisma/engines@5.22.0": true,
    "@google/genai@2.30.0": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true
  }
}
